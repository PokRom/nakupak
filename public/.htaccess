# Nákupák – nastavení pro Apache (běžný hosting WordPressu).
# Soubory se servírují přímo, WordPress do této složky nezasahuje.

<IfModule mod_headers.c>
  # Hlavní stránka a service worker se vždy načtou čerstvé, aby se projevily aktualizace.
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Soubory v assets/ mají v názvu otisk obsahu, takže je lze cachovat dlouho.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html
